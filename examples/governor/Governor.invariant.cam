// Invariant: configuration immutability — m_token, m_timelock, m_admin,
// m_voting_period, m_quorum are set once in the constructor and never
// rewritten by any later route. We pick m_quorum as a witness and check
// it survives an arbitrary mix of propose / queue / execute / cancel
// calls.

invariant "quorum is immutable" for Governor {
    init { m_quorum: 1000 }

    action propose(target: address, value: U256, data: CamData,
                   description_hash: U256) { }
    action queue(proposal_id: U256, target: address, value: U256,
                 data: CamData, description_hash: U256) { }
    action execute(proposal_id: U256, target: address, value: U256,
                   data: CamData, description_hash: U256) { }
    action cancel(proposal_id: U256) { }

    check m_quorum == 1000
}
