// Multi-entity invariant (Governor-owned): the Governor's immutable
// configuration and the ERC20Votes supply are independent surfaces. We
// drive BOTH contracts in a single trace and assert that the governor's
// constructor-set config survives arbitrary token activity while the
// token's supply is untouched by the non-mint/burn routes we drive.
//
// The first instance's entity (`g: Governor`) owns the emitted spec, so
// this lands in `GovernorSpec.lean`. Checks reference both instances via
// the qualified `<inst>.<member>` form (I11), exercising the multi-entity
// world initialiser and cross-entity state reads under Plausible.
invariant "config and supply independent" for { g: Governor, tok: ERC20Votes } {
    init g { m_quorum: 1000, m_voting_period: 50 }
    init tok { m_total_supply: 1000 }

    action g.propose(target: address, value: U256, data: CamData,
                     description_hash: U256) { }
    action g.cancel(proposal_id: U256) { }
    action tok.transfer(to: address, amount: U256) { }
    action tok.delegate(to: address) { }

    check g.m_quorum == 1000
    check g.m_voting_period == 50
    check tok.m_total_supply == 1000
}
