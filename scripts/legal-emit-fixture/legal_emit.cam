// Minimal program for the legal CI emit-header gate. Uses std::math and
// wrapping so EVM injects helpers; a property so Lean emits Spec + plausible
// overlay hooks.

entity LegalEmit {
    routes {
        bump(x: u64) => []
        wrap(x: u64) => []
    }

    m_value: u64 {
        in bump(x) => std::math::muldiv(m_value, x, 1)
        in wrap(x) => m_value +% x
    }
}

property "wrap from zero" (x: u64) for LegalEmit with { m_value: 0 } {
    call wrap(x)
    expect state { m_value: x }
}
