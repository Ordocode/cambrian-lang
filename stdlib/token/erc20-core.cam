// erc20-core — pure helpers shared by the standard-library ERC20 entities.
//
// Importable (F4-clean: no entity, test, fuzz or invariant here), which is
// the point: the singleton and multi-instance tokens differ only in whether
// they carry an `identity` member, and every line of arithmetic and every
// EIP-712 hash below is common to both. Two copies of this text would drift.
//
// Storage-mapping parameters: on EVM a `HashMap<K, V>` parameter lowers to
// `mapping(K => V) storage`, and a missing key reads as zero, so the accessors
// below need no `exists()` guard.

// The zero address. Written as a literal rather than compared against `0`
// because the EVM backend will not compare an `address` to an integer
// constant, and a helper keeps every guard reading the same way.
pure fn zero_address() -> address {
    0x0000000000000000000000000000000000000000
}

pure fn balance_of(balances: HashMap<address, U256>, owner: address) -> U256 {
    balances[owner]
}

// Allowances are keyed by `hashOf(owner, spender)` rather than a nested
// `HashMap<address, HashMap<address, U256>>`. `hashOf` lowers to
// `keccak256(abi.encode(...))`, giving the same compound-key semantics as
// Solidity's nested mapping while staying on the EVM backend's exercised path.
pure fn allowance_of(allowances: HashMap<U256, U256>,
                     owner: address, spender: address) -> U256 {
    allowances[hashOf(owner, spender)]
}

pure fn nonce_of(nonces: HashMap<address, U256>, owner: address) -> U256 {
    nonces[owner]
}

// The sentinel that means "unlimited": 2^256 − 1.
//
// Built arithmetically because neither literal spelling is available — a
// decimal this large panics the transpiler, and a hex literal is inferred as
// `bytes32`, which then poisons every arithmetic operation on the value.
//
// Named for the role rather than the magnitude, and that is not cosmetic.
// `stdlib/math.cam` declares the same number as `u256_max`, and pure functions
// are program-scoped: any project importing both files got a duplicate-name
// error at load time. That is every project layering a vault or an AMM over
// this token, which is the whole reason the two components exist separately.
// Stating the constant twice is still the right trade — a token importer
// should not have to depend on the math component for one number — but the
// two copies must not claim the same name.
pure fn unlimited_allowance() -> U256 {
    let half = 18446744073709551615 as U256;
    let two_128 = (half + 1) * (half + 1);
    (two_128 * (two_128 - 1)) + (two_128 - 1)
}

// An allowance of 2^256 − 1 means "unlimited" by convention and is not
// decremented on spend, matching OpenZeppelin. This is a gas optimisation, not
// an ERC-20 requirement, but integrations that grant an infinite approval and
// never re-approve depend on it in practice.
pure fn is_infinite_allowance(current: U256) -> bool {
    current == unlimited_allowance()
}

// The allowance remaining after spending `amount`, infinite approvals aside.
pure fn allowance_after_spend(current: U256, amount: U256) -> U256 {
    if is_infinite_allowance(current) { current } else { current - amount }
}

// ── EIP-712 / EIP-2612 ───────────────────────────────────────────────

//   keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
pure fn eip712_domain_typehash() -> U256 {
    0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f
}

//   keccak256("Permit(address owner,address spender,uint256 value,uint256 nonce,uint256 deadline)")
pure fn permit_typehash() -> U256 {
    0x6e71edae12b1b97f4d1f60370fef10105fa2faae0126114a169c64845d6126c9
}

// The domain separator, recomputed per call rather than cached at
// construction. Caching is the usual gas optimisation and it is wrong across a
// chain split: a cached separator keeps the old `chainId`, so signatures
// endorsed for one chain verify on the other. `chainid` and `this_addr` are
// read from the environment by the caller, so the separator always describes
// the chain the call is actually executing on.
pure fn domain_separator(hashed_name: U256, hashed_version: U256,
                         chainid: U256, this_addr: address) -> bytes32 {
    hashOf(eip712_domain_typehash(), hashed_name, hashed_version,
           chainid, this_addr)
}

// The permit message, hashed. Kept separate from the separator so the two are
// combined by nesting two small calls rather than by one call taking the union
// of their arguments: the guard that uses them sits inside a route that
// already holds seven parameters, and a single wide call exhausts Solidity's
// stack under the default (non-IR) pipeline.
pure fn permit_struct_hash(owner: address, spender: address, value: U256,
                           nonce: U256, deadline: U256) -> bytes32 {
    hashOf(permit_typehash(), owner, spender, value, nonce, deadline)
}

pure fn permit_digest(separator: bytes32, struct_hash: bytes32) -> bytes32 {
    evm::keccak256Packed(b"\x19\x01", separator, struct_hash)
}

// The EIP-712 signer of a permit message.
//
// Called from the route's `where` clause so a bad signature is rejected before
// any storage write — route bodies in Cambrian run after member transforms.
//
// `ecrecover` returns the zero address for a malformed signature, so a caller
// must never treat "recovered == owner" as sufficient without also rejecting a
// zero owner. The entities below reject a zero owner in the same guard.
pure fn permit_signer(separator: bytes32, struct_hash: bytes32,
                      v: u8, r: bytes32, s: bytes32) -> address {
    evm::ecrecover(permit_digest(separator, struct_hash), v, r, s)
}
