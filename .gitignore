# Rust build artifacts
target/
Cargo.lock

# Generated parser (rebuilt by lalrpop)
cambrian-transpiler/src/cambrian.rs

# IDE
.vscode/
.idea/
.cursor/

# OS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Temp test outputs
/tmp/

# E2E test build artifacts and deployment-specific files
# (all test artifacts go to build/tests/)

# Generated test projects (cargo check targets)
cambrian-transpiler/tests/generated/

# Temporary test files
cambrian-transpiler/tests/tmp/

# Local Foundry fuzz failure snapshots (not read by harness/CI)
cambrian-transpiler/cache/

# LLVM coverage profiles (cargo llvm-cov)
*.profraw

# Solidity compiler artifacts
*.abi.json
*.tvc
*.code
*.debug.json

# Tool build cache (created by tools/build-tools.sh)
tools/.build-cache/

# Transpiler output (default: build/<name>-entity/)
build/
build-lean/
*-entity/

# Foundry deps. Default `forge install` used to `git submodule add` these into
# the parent Cambrian repo as mode-160000 gitlinks; they must stay untracked.
**/lib/forge-std/

# Lake lockfiles generated by local `lake build` on golden fixtures (not source)
**/lake-manifest.json

# EVM transpile provenance sidecar (local re-transpile; fixtures pin sources, not manifest)
**/.cambrian-manifest.json

# Local-only transpile output for contracts/project_trace_invariant.yaml (tests codegen in-memory)
contracts/build_trace_invariant/
