entity PhasedExpr {
    routes {
        bump(amount: u64) => [
            inc: []
            mirror: []
        ]
    }
    m_a: u64 {
        in bump(amount) => inc: m_a + amount
    }
    m_b: u64 {
        in bump(amount) => mirror: ^m_a
    }
}
