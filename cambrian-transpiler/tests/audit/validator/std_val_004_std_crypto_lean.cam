// T-STD-VAL-004: std::crypto::sha256 on Lean target must trigger L13.

entity StdCryptoLeanProbe {
    routes {
        constructor() => []
        hash() -> u64 => [ return(std::crypto::sha256("x")) ]
    }

    m_x: u64 {
        in constructor() => 0
    }
}
