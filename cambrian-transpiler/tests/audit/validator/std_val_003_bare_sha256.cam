// T-STD-VAL-003: bare `sha256` must trigger V49 (use std::crypto::sha256).

entity BareSha256Probe {
    routes {
        view hash() -> bytes => [
            return(sha256("data"))
        ]
    }

    m_x: u64 {}
}
