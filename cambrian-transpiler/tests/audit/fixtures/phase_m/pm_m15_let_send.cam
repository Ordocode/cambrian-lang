// T-X-SEND-001 / PM-015: `let dest = Entity.address(...)` must keep typed send on Lean.

entity Treasury {
    identity tid: u64

    routes {
        #[factory_only]
        init create() => []
        credit() => []
    }

    m_total: u64 {
        in create() => 0
        in credit() => m_total
    }
}

entity Sender {
    identity sid: u64

    routes {
        #[factory_only]
        init create() => []
        ping(tid: u64) => [
            let dest = Treasury.address(tid);
            credit() ~> dest
        ]
    }

    m_x: u64 {}
}
