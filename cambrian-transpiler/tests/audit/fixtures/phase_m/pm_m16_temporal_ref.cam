// T-X-ORD-001 / PM-016: `^m_a` uses the new, already-computed value of `m_a`.

entity Ord {
    routes {
        #[factory_only]
        init create() => []
        bump() => []
    }

    m_b: u64 {
        in create() => 0
        in bump() => m_b + ^m_a
    }

    m_a: u64 {
        in create() => 0
        in bump() => m_a + 1
    }
}
