// T-X-CONT-001 / PM-003 (MA-N01): `deploy` on Container must not silently stub.

entity Child {
    identity id: u64

    routes {
        #[factory_only]
        init create() => []
    }

    m_x: u64 {
        in create() => id
    }
}

entity Parent {
    routes {
        #[factory_only]
        init create() => []
        spawn(k: u64) => [
            deploy Child(k)
        ]
    }

    m_n: u64 {}
}
