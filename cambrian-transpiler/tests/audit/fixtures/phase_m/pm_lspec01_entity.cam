// T-LEAN-SPEC-001 / PM-005 (MA-LSPEC01): effects-only test must not collapse
// to vacuous `| .ok w => True`.

entity E {
    m_x: u64 {
        in pay(v) => m_x + v
    }

    routes {
        pay(v: u64) => [
            ~> msg::sender
        ]
    }
}
