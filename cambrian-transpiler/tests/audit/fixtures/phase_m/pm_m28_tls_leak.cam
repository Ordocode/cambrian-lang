// T-EVM-TLS-001 / PM-028: test harness reads ACTIVE_CTX via gen_expr_test.
// Non-det mode must not emit ICambrianFactory.predict* for Entity.address(...).

entity TlsPeer {
    identity m_id: u64

    routes {
        #[factory_only]
        constructor() => []
        receivePing() => []
    }
}

entity TlsHost {
    identity m_id: u64

    routes {
        #[factory_only]
        constructor() => []

        ping(peer_id: u64) => [
            receivePing() ~> TlsPeer.address(peer_id)
        ]
    }
}

test "peer send effect addr" for TlsHost with { m_id: 1 } {
    call ping(7)
    expect effects [~> TlsPeer.address(7), ..]
}
