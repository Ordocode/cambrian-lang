// T-EVM-DET-002 / PM-026: factory deploy* owner guard vs Lean occupancy-only deploy.

entity DeployTarget {
    identity m_id: u64

    routes {
        #[factory_only]
        constructor() => []
        touch() => []
    }

    m_x: u64 {
        in constructor() => 0
        in touch() => m_x + 1
    }
}

entity DeployCaller {
    routes {
        #[factory_only]
        constructor() => []
        spawn(id: u64) => [
            deploy DeployTarget(id)
        ]
    }

    m_n: u64 {}
}
