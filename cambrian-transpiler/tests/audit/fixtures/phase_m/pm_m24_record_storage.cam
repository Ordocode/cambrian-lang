// T-EVM-STOR-001 / PM-024: struct member storage must match solc layout (not one word).

entity S {
    record Info {
        lo: U256,
        hi: U256,
    }

    m_a: u64 {
        in bump(v) => m_a + v
    }
    m_info: Info {
        in bump(v) => m_info
    }
    m_b: u64 {
        in bump(v) => m_b + v
    }

    routes {
        bump(v: u64) => []
    }
}
