// PW3-G-004 row 2: underfunded dynamic dispatch with `{ value }` (residual getD).

entity Payee {
    identity m_id: u64

    routes {
        #[factory_only]
        init create() => []
        accept deposit() => []
        getBalance() -> u128 => [ return(m_balance) ]
    }

    m_balance: u128 {
        in create() => 0
        in deposit() => m_balance + msg::value as u128
    }
}

entity Payer {
    identity m_id: u64

    routes {
        #[factory_only]
        init create(dest: Address<Payee>) => []

        pay(amount: u128) => [
            deposit() ~> m_dest with { value: amount }
        ]
    }

    m_dest: Address<Payee> {
        in create(dest) => dest
    }
}
