// Audit baseline for T-LEAN-006 / LEAN-H8 (POLICY): one invariant theorem
// is expected to fall through to `| sorry` (or `by sorry`). Cambrian ships
// statements, not proofs of main theorems — see PLAN_LEAN_TARGET "Sorry policy".

entity Counter {
    routes {
        #[factory_only]
        init create() => []
        bump() => []
        getCount() -> u64 => [ return(m_count) ]
    }

    m_count: u64 {
        in create() => 0
        in bump() => m_count + 1
    }
}

invariant "count bounded" for Counter {
    init { m_count: 0 }

    action bump() { }

    check m_count <= 1_000_000
}
