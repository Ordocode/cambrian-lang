// PN-103: checked add at U256::MAX — EVM must revert, Lean must not wrap silently.

entity Adder {
    routes {
        #[factory_only]
        constructor() => []
        bump(n: U256) => []
        get() -> U256 => [ return(m_x) ]
    }

    m_x: U256 {
        in constructor() => 0
        in bump(n) => m_x + n
    }
}
