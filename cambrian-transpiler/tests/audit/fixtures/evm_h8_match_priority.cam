// Audit hypothesis EVM-H8: match arm priority inverted by reverse fold.

entity Matcher {
    routes {
        #[factory_only]
        constructor() => []
        setCode(code: u64) => []
        classify() -> u64 => [
            return(m_result)
        ]
    }

    m_code: u64 {
        in constructor() => 0
        in setCode(code) => code
    }

    m_result: u64 {
        in classify() => {
            match m_code {
                0 => 100,
                1 => 200,
                _ => 999
            }
        }
    }
}
