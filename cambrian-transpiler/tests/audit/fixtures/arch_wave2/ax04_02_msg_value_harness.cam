// T-ARCH-003 / H-AX-04-02: `msg { value }` in test steps — one-shot for the
// next call only (EVM: `vm.deal` + `{value: N}`; Lean: scoped `ctx_call`).

entity ValueProbe {
    routes {
        #[factory_only]
        constructor() => []

        capture() -> u64 => [
            return(msg::value as u64)
        ]
    }

    m_last: u64 {
        in constructor() => 0
    }
}

test "msg value deal not msg.value" for ValueProbe {
    msg { value: 42 }
    call capture()
    expect return 42
}
