// T-ARCH-023 / H-AX-03-05: bare `throw` must keep route fail-mode; Lean must not
// emit `-- throw N (skipped: route inferred non-failing)`.

entity ThrowProbe {
    routes {
        #[factory_only]
        constructor() => []

        bail() => [
            throw 42
        ]
    }
}
