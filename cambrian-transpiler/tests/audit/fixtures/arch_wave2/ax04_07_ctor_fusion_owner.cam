// T-ARCH-029 / H-AX-04-07: det pair-fusion `msg { sender }` + `call constructor(arg)`
// when sender == arg — EVM emits `initialize(arg)` before `vm.startPrank(sender)`,
// so `msg::sender` in init transforms is the test contract, not the pinned sender.

entity OwnerProbe {
    const ALICE: address = 0x0000000000000000000000000000000000000002

    routes {
        #[factory_only]
        constructor(holder: address) => []

        getOwner() -> address => [
            return(m_owner)
        ]
    }

    m_owner: address {
        in constructor(holder) => msg::sender
    }

    m_holder: address {
        in constructor(holder) => holder
    }
}

test "msg ctor fusion owner" for OwnerProbe {
    msg { sender: ALICE }
    call constructor(ALICE)
    call getOwner()
    expect return ALICE
}
