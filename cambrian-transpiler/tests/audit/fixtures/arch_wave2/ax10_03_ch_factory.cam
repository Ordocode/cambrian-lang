// T-ARCH-034 / H-AX-10-03: deterministic_addresses (CH factory) — EVM ctor
// takes `factory_` + zero guard; Lean uses opaque `create2Address` stub.

entity DetProbe {
    routes {
        #[factory_only]
        constructor() => []
    }

    m_x: u64 {
        in constructor() => 0
    }
}
