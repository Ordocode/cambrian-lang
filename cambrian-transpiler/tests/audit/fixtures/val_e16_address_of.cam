// T-VAL-005: `address_of` outside deterministic mode must trigger validator E16.

entity Other {
    routes {
        view get() -> u64 => [
            return(0)
        ]
    }

    m_id: u64 {}
}

entity AddressOfProbe {
    routes {
        view who() -> address => [
            return(address_of Other(1))
        ]
    }

    m_dummy: u64 {}
}
