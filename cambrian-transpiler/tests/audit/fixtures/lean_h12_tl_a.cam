// T-LEAN-010 fixture A: proof_helpers off + numerics nat (thread-local priming).

entity TlLeakA {
    routes {
        #[factory_only]
        init create() => []
        inc() => []
    }

    m_count: u64 {
        in create() => 0
        in inc() => m_count + 1
    }
}

invariant "bounded-a" for TlLeakA {
    init { m_count: 0 }
    action inc() { }
    check m_count < 1000
}
