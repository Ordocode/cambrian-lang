// PW3-S-001 baseline: two u64 members pack into one slot (offset 0 and 8).

entity U64Pair {
    routes {
        #[factory_only]
        constructor() => []
    }

    m_a: u64 {
        in constructor() => 0
    }

    m_x: u64 {
        in constructor() => 0
    }
}
