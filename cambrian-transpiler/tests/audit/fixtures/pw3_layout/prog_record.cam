// PW3-S-001 / PW3-O-004: program-scope record member — ctor must not assign literal 0.

record Info {
    a: u64,
    b: u64,
}

entity ProgRecord {
    routes {
        #[factory_only]
        constructor() => []
    }

    m_info: Info {
        in constructor() => m_info
    }

    m_x: u64 {
        in constructor() => 0
    }
}
