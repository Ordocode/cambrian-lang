entity Token {
    routes {
        #[factory_only]
        constructor() => []
        transfer(to: address, amount: u64) => []
        approve(spender: address, amount: u64) => []
        view totalSupply() -> u64 => [ return(m_supply) ]
    }

    m_supply: u64 {
        in constructor() => 1000
    }
}
