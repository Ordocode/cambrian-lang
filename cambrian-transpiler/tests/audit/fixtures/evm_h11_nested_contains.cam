// Audit hypothesis EVM-H11: nested HashMap.contains() may reference
// _inner_exists without emitting the sidecar (detection only checks .exists).

entity Allowance {
    routes {
        #[factory_only]
        constructor() => []
        hasPair(owner: address, spender: address) -> bool => [
            return(m_allowances[owner].contains(spender))
        ]
    }

    m_allowances: HashMap<address, HashMap<address, u64>> {
        in constructor() => HashMap::new()
    }
}
