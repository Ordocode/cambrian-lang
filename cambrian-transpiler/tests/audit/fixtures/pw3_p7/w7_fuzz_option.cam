// PW3-G-008: W7 documents non-scalar property param fallback on EVM fuzz backends.

entity W7Host {
    routes {
        #[factory_only]
        constructor() => []
    }

    m_x: u64 {
        in constructor() => 0
    }
}

property "opt param" (o: Option<u64>) for W7Host with { m_x: 0 } {
    call constructor()
    expect state { m_x: 0 }
}
