// PW3-G-007: E07 warns on closure-as-value in route body; EVM runtime reverts.

entity ClosureAdmit {
    routes {
        #[factory_only]
        constructor() => []

        run() -> u64 => [
            let f = |x| *x + 1;
            return(0)
        ]
    }

    m_x: u64 {
        in constructor() => 0
    }
}
