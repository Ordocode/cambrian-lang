// PW3-G-003 / PN-110: Native `compute_address` vs EVM CREATE2 `predict*`.

entity PredictTarget {
    identity m_id: u64

    routes {
        #[factory_only]
        constructor() => []
        ping() => []
    }

    m_x: u64 {
        in constructor() => 0
        in ping() => m_x + 1
    }
}
