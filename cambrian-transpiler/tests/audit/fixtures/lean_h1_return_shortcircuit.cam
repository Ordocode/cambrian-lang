// Audit hypothesis LEAN-H1: `return` / `throw` must short-circuit; dead
// actions after a terminator must not appear in generated Lean.

entity ShortCircuit {
    event Logged(v: u64);

    routes {
        #[factory_only]
        init create() => []

        go(n: u64)
            where n < 1000 : throw 1
        => [
            emit Logged(1);
            throw 5
            emit Logged(2);
        ]
    }

    m_x: u64 {}
}
