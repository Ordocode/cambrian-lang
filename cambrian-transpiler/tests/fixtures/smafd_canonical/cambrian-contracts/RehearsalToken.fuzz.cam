// Supplemental fuzz — links catalog PROP-RHT-003 with a tighter bound.
#[instantiates("PROP-RHT-003")]
property "CP-001 transfer half supply bound" (amount: U256) for RehearsalToken {
    assume amount > 0 && amount <= INITIAL_SUPPLY / 2
}
