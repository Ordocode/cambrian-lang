// Stateful supplemental invariant — links catalog INV-RHT-001 with init delta.
invariant "CP-001 stateful fixed total supply" #[instantiates("INV-RHT-001")] for RehearsalToken {
    init { m_total_supply: INITIAL_SUPPLY }
}
