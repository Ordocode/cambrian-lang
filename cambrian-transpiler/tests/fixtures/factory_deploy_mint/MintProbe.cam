// BUG-U4 regression: init-route param (holder) must receive mint via factory.deploy*(holder).

entity MintProbe {
    const SUPPLY: u64 = 1000

    routes {
        #[factory_only]
        constructor(holder: address) => []

        view holder() -> address => [ return(m_holder) ]
        view supply() -> u64 => [ return(m_supply) ]
    }

    m_holder: address {
        in constructor(holder) => holder
    }

    m_supply: u64 {
        in constructor(holder) => SUPPLY
    }
}
