// Two-member, two-phase fixture for the Lean target.
// Exercises the `^m_a` post-phase reference: phase `mirror` sees the
// post-phase value of `m_a` (i.e. the result of the `inc` phase
// applied to the inbound state).

entity TwoMember {
    routes {
        bump(amount: u64) => [
            inc: []
            mirror: []
        ]
    }

    m_a: u64 {
        in bump(amount) => inc: m_a + amount
    }

    m_b: u64 {
        in bump(amount) => mirror: ^m_a
    }
}
