entity Token {
    const INITIAL_SUPPLY: U256 = 1000

    routes {
        constructor() => []
        view totalSupply() -> U256 => [ return(m_total) ]
    }

    m_total: U256 {
        in constructor() => INITIAL_SUPPLY
    }
}
