// RehearsalToken (RHT) — fixed-supply ERC-20 for platform rehearsal.
// Authored from ground-truth spec docs/cambrian-spec/RehearsalToken.spec.cam.

pure fn balance_of(balances: HashMap<address, U256>, owner: address) -> U256 {
    balances[owner]
}

pure fn allowance_of(allowances: HashMap<U256, U256>,
                     owner: address, spender: address) -> U256 {
    allowances[hashOf(owner, spender)]
}

pure fn sum_values(values: HashMap<address, U256>) -> U256 {
    values.values().fold(0, |acc, v| acc + v)
}

entity RehearsalToken {

    const INITIAL_SUPPLY: U256 = 1000000000000000000000000
    const ZERO: address = 0x0000000000000000000000000000000000000000
    const MAX_UINT256: U256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935

    event Transfer(indexed src: address, indexed dst: address, value: U256);
    event Approval(indexed owner: address, indexed spender: address, value: U256);

    routes {
        constructor() => [
            emit Transfer(ZERO, msg::sender, INITIAL_SUPPLY);
        ]

        transfer(to: address, amount: U256) -> bool
            where to != ZERO : throw 201 &&
                  balance_of(m_balances, msg::sender) >= amount : throw 202
            => [
                emit Transfer(msg::sender, to, amount);
                return(true)
            ]

        approve(spender: address, amount: U256) -> bool
            where spender != ZERO : throw 201
            => [
                emit Approval(msg::sender, spender, amount);
                return(true)
            ]

        transferFrom(from_addr: address, to: address, amount: U256) -> bool
            where from_addr != ZERO && to != ZERO : throw 201 &&
                  balance_of(m_balances, from_addr) >= amount : throw 202 &&
                  allowance_of(m_allowances, from_addr, msg::sender) >= amount : throw 203
            => [
                emit Transfer(from_addr, to, amount);
                return(true)
            ]

        view name() -> String => [ return("Rehearsal Token") ]
        view symbol() -> String => [ return("RHT") ]
        view decimals() -> u8 => [ return(18) ]
        view totalSupply() -> U256 => [ return(m_total_supply) ]
        view balanceOf(owner: address) -> U256 => [
            return(balance_of(m_balances, owner))
        ]
        view allowance(owner: address, spender: address) -> U256 => [
            return(allowance_of(m_allowances, owner, spender))
        ]
        view sumBalances() -> U256 => [
            return(sum_values(m_balances))
        ]
    }

    m_total_supply: U256 {
        in constructor() => INITIAL_SUPPLY
    }

    m_balances: HashMap<address, U256> {
        in constructor() => {
            {}.insert(msg::sender, INITIAL_SUPPLY)
        }
        in transfer(to, amount) => {
            let sender = msg::sender;
            let bal_from = balance_of(m_balances, sender);
            let bal_to   = balance_of(m_balances, to);
            if to == sender { m_balances } else {
                m_balances
                    .update(sender, bal_from - amount)
                    .update(to,     bal_to   + amount)
            }
        }
        in transferFrom(from_addr, to, amount) => {
            let bal_from = balance_of(m_balances, from_addr);
            let bal_to   = balance_of(m_balances, to);
            if from_addr == to { m_balances } else {
                m_balances
                    .update(from_addr, bal_from - amount)
                    .update(to,        bal_to   + amount)
            }
        }
    }

    m_allowances: HashMap<U256, U256> {
        in approve(spender, amount) => {
            m_allowances.update(hashOf(msg::sender, spender), amount)
        }
        in transferFrom(from_addr, _, amount) => {
            let key = hashOf(from_addr, msg::sender);
            let prev = allowance_of(m_allowances, from_addr, msg::sender);
            let next = if prev == MAX_UINT256 { prev } else { prev - amount };
            m_allowances.update(key, next)
        }
    }
}
