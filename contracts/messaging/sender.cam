entity Sender {

    routes {
        sendValue(dest: Address<Receiver>, value: u64) => [
            acceptValue(value) ~> dest
        ]
        getSent() -> u64 => [
            return(m_last_sent)
        ]
    }

    m_last_sent: u64 {
        in sendValue(_, value) => value
    }
}
