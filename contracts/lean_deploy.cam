// P4a smoke: deploy Entity(args).

entity Child {
    identity m_id: u64

    routes {
        constructor() => []
    }
}

entity Factory {
    routes {
        constructor() => []

        spawn(id: u64) => [
            deploy Child(id)
        ]
    }
}
