entity Vault {
    identity m_id: u64

    routes {
        #[factory_only]
        constructor(initialBalance: u64) => []
        deposit(amount: u64)
            where amount > 0 : throw 1
            => []
        getBalance() -> u64 => [
            return(m_balance)
        ]
    }

    m_balance: u64 {
        in constructor(initialBalance) => initialBalance
        in deposit(amount) => m_balance + amount
    }
}
