// Registry: exercises complex types — HashMap<u64, u64>, String
// Used for E2E testing of state serialization for complex types

entity Registry {

    routes {
        constructor(name: String) => []

        putEntry(key: u64, value: u64) => []
        getEntry(key: u64) -> u64 => [
            return(m_entries[key])
        ]
        getEntryCount() -> u64 => [
            return(m_entry_count)
        ]
        getName() -> String => [
            return(m_name)
        ]
    }

    m_name: String {
        in constructor(name) => name
    }

    m_entries: HashMap<u64, u64> {
        in constructor(_) => {}
        in putEntry(key, value) => m_entries.update(key, value)
    }

    m_entry_count: u64 {
        in constructor(_) => 0
        in putEntry(_, _) => m_entry_count + 1
    }
}
